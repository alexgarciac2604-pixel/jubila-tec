# ============================================================
# Jubila-Tec Terminal — environment variables
# Copy this file to ".env" and fill the keys you have.
# The app RUNS WITHOUT ANY KEY (uses yfinance + sample fallback).
# Keys only unlock extra data sources.
# ============================================================

# --- News (https://newsapi.org/ — free tier) -------------------
NEWSAPI_KEY=

# --- Macro: FRED (https://fred.stlouisfed.org/docs/api/api_key.html) ---
FRED_API_KEY=

# --- Optional market data providers (freemium) -----------------
ALPHAVANTAGE_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
TIINGO_API_KEY=
FINNHUB_API_KEY=

# --- App behaviour ---------------------------------------------
# Force synthetic data even when online (useful for demos / offline dev)
JT_FORCE_SAMPLE=0
# Cache TTL in seconds for market data
JT_CACHE_TTL=900
# Logging level: DEBUG | INFO | WARNING | ERROR
JT_LOG_LEVEL=INFO

# --- Fase 4: capa humana (opcionales) ---
# Copiloto conversacional (sin ella usa plantillas deterministas)
ANTHROPIC_API_KEY=
# Modelo del copiloto (por defecto claude-sonnet-4-5)
JT_COPILOT_MODEL=
# Alertas y briefing por Telegram (crea un bot con @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
